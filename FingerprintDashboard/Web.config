<?xml version="1.0"?>
<configuration>
  <appSettings>
    <!-- UNC path to the Access file on the fingerprint server (share it READ-ONLY). -->
    <add key="AccessSourcePath" value="\\FP-SERVER\FingerprintData\attendance.mdb"/>
    <!-- Local folder (writable by the app pool identity) for the cached copy. -->
    <add key="LocalCacheFolder" value="C:\DashboardCache"/>
    <!-- Re-copy the source file if the cached copy is older than this many seconds. -->
    <add key="CacheSeconds" value="60"/>
    <!-- Max rows loaded per preview. -->
    <add key="MaxRows" value="5000"/>
    <!-- Optional: .mdb/.accdb password -->
    <add key="AccessPassword" value=""/>
  </appSettings>
  <system.web>
    <compilation debug="false" targetFramework="4.8"/>
    <httpRuntime targetFramework="4.8"/>
    <!-- Protect the dashboard: attendance data is sensitive. -->
    <authentication mode="Windows"/>
    <authorization>
      <deny users="?"/>
    </authorization>
  </system.web>
</configuration>
